# ==========================================================
# EnTuCel Repair Manager — Archivo de Configuración de Entorno
# ==========================================================
# ADVERTENCIA: NUNCA SUBIR EL ARCHIVO DE PRODUCCIÓN .env AL REPOSITORIO DE CÓDIGO GIT.

# Proveedor de backend activo:
# - 'memory': Backend mock de pruebas locales persistido en LocalStorage (ideal para desarrollo sin credenciales).
# - 'firebase': Backend de producción conectado a Firestore y Firebase Auth.
VITE_BACKEND_PROVIDER=memory

# Configuración de Firebase (requerida cuando VITE_BACKEND_PROVIDER=firebase)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# ----------------------------------------------------------
# DESPLIEGUE DE REGLAS E ÍNDICES DE FIRESTORE EN PRODUCCIÓN:
# ----------------------------------------------------------
# Para desplegar las reglas de seguridad e índices del proyecto ejecute:
# firebase deploy --only firestore:rules,firestore:indexes
